# ============================================
# TWARVIS SCHOOL - Environment Variables Template
# ============================================
# Copy this to .env and fill in your values
# NEVER commit .env to version control!
# ============================================

# ========== REQUIRED ==========

# Supabase Configuration
# Get these from: https://app.supabase.com → Your Project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_key_here  # Use for admin operations only

# Django Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secret_key_here_at_least_32_chars

# ========== OPTIONAL ==========

# Admin Access (Set to 'true' only if you need admin panel)
ADMIN=false

# Debug Mode (Set to 'true' only for local development)
DEBUG=false

# Allowed Hosts (comma separated, no spaces)
ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com,*.pages.dev

# Port (Render sets this automatically)
PORT=8000

# ========== SECURITY SETTINGS ==========

# HTTPS Settings
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# Cookie Security
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE='Lax'

# ========== RATE LIMITING ==========
# Maximum uploads per user per hour
MAX_UPLOADS_PER_HOUR=5

# Maximum passcode attempts per file per hour
MAX_PASSCODE_ATTEMPTS=5

# ============================================
# GENERATE SECRETS:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================
